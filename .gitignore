# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# `.env*` would also swallow `.env.example`, which must stay tracked: it is the
# only place the full variable list, its meaning and its format are documented.
# It holds placeholders only, never a real secret.
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory
/skills/
# Local DB snapshots created by `bun run db:backup`
prisma/backups/

# Local SQLite database (schema lives in prisma/schema.prisma)
prisma/*.db
prisma/*.db-journal

# Local agent/tool state
.freebuff/
.workbuddy-ai/

# Security audit working files: raw PoC responses, test scripts, DB snapshot.
# The written report (SECURITY_AUDIT.md) stays tracked; the working files do not.
security-audit/

# Credential handoff files — never commit anything that could carry a password
credentials*.txt
*.credentials.txt

# Archived copies of this project. These embed .env and prisma/dev.db, so they
# must never reach a public repository.
*.zip

# User-uploaded product images (keep the folder, not the files)
public/uploads/*
!public/uploads/.gitkeep
public/uploads/chat/*
!public/uploads/chat/.gitkeep
